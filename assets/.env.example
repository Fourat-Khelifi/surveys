# Copy to assets/.env and fill in from your Supabase project settings.
#
# The publishable key is designed to ship inside the client — it is not a
# secret. Row Level Security is what protects the data, which is why the
# policies in supabase/migrations/ matter more than this value does.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
